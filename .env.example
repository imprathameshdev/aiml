# --- Lot Vulture Environment Configuration ---

# --- Logging ---
# Logging level: DEBUG, INFO, WARNING, ERROR (default: DEBUG)
VULTURE_LOG_LEVEL=DEBUG

# Maximum days to retain rotated log archives before auto-deleting (default: 5)
VULTURE_LOG_RETENTION_DAYS=5

# --- Storage Quotas (RollingLMDB) ---
# Maximum disk storage (in GB) allowed for image snapshots and vehicle crops.
# When the database reaches this size, the oldest 1 GB chunk is automatically
# deleted (First-In, First-Out rolling eviction).
VULTURE_SNAPSHOT_MAX_SIZE_GB=1000
VULTURE_CROP_MAX_SIZE_GB=1000

# --- Directory Paths ---
# Directory holding the SQLite database, logs, LMDB blobs, and secret key.
# Linux default: /var/lib/lotvulture (falls back to ~/.lotvulture when non-root)
# Windows default: C:\ProgramData\LotVulture
VULTURE_LV_HOME=/var/lib/lotvulture

# --- Security ---
# Secret key for JWT signing. If left blank, a secure 48-byte key
# is automatically generated and saved to $LV_HOME/secret_key on first startup.
VULTURE_SECRET_KEY=

# --- Database ---
# Set to true to log every raw SQL query to the console
VULTURE_SQL_ECHO=false
# WAL mode is highly recommended for SQLite concurrency
VULTURE_SQL_WAL_MODE=true

# --- OpenTelemetry & Jaeger Tracing ---
# Set to true to enable distributed tracing (Requires Jaeger/OTLP collector)
VULTURE_OTEL_ENABLED=false
VULTURE_SERVICE_NAME=lot-vulture-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Performance Profiling ---
# Set to true to enable memory allocation tracing (high overhead)
VULTURE_PROFILE_MEMORY=false

# --- Billing / License Integration ---
# Base URL of the Lot Vulture cloud billing portal.
# Leave empty to default to https://license.lotvulture.com
VULTURE_BILLING_PORTAL_URL=

# How often (in seconds) the backend POSTs heartbeat telemetry to billing (default: 600)
VULTURE_HEARTBEAT_INTERVAL_SECONDS=600

# --- Improve AI Feedback Uploads ---
# Max feedback submissions queued locally before showing a warning chip
# in the History view. Default 100 — operators typically submit a handful
# per day, so a queue this large means the cloud billing portal is unreachable.
VULTURE_FEEDBACK_QUEUE_WARN=100

# --- Docker Container Version ---
# Image tag used by docker-compose.yml. Defaults to 'latest' (always pulls
# the most recent release). Set to a specific release tag to pin (e.g. v2026.09.02-fc88f2f).
# VULTURE_VERSION=latest

